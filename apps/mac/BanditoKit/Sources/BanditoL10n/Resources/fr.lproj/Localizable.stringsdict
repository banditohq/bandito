		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld agent attend votre action</string>
			<key>other</key>
			<string>%1$lld agents attendent votre action</string>
		</dict>
	</dict>
	<key>onboarding.server.minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>≈ %1$lld minute</string>
			<key>other</key>
			<string>≈ %1$lld minutes</string>
		</dict>
	</dict>
	<key>thread.ranCommands</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld commande exécutée</string>
			<key>other</key>
			<string>%1$lld commandes exécutées</string>
		</dict>
	</dict>
</dict>
</plist>
