		</dict>
	</dict>
	<key>common.workingCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%1$lld actifs</string>
		</dict>
	</dict>
	<key>inspector.uptime</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>actif depuis %1$lld jour</string>
			<key>other</key>
			<string>actif depuis %1$lld jours</string>
		</dict>
	</dict>
	<key>memory.filesMeta</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld fichier créé par %2$@ pour lui-même</string>
			<key>other</key>
			<string>%1$lld fichiers créés par %2$@ pour lui-même</string>
		</dict>
	</dict>
	<key>memory.journalMeta</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Aujourd'hui : %1$lld entrée · hier : %2$@</string>
			<key>other</key>
			<string>Aujourd'hui : %1$lld entrées · hier : %2$@</string>
		</dict>
	</dict>
	<key>memory.searchResult</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%2$#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>« %1$@ » · %2$lld résultat, %3$@</string>
			<key>other</key>
			<string>« %1$@ » · %2$lld résultats, %3$@</string>
		</dict>
	</dict>
