    "server.add.urlDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, ein Reverse-Proxy: jede URL, die den Daemon erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, a reverse proxy — any URL that reaches the daemon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, un proxy inverso: cualquier URL que llegue al demonio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, un proxy inverse : toute URL qui atteint le démon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel、WireGuard、リバースプロキシなど。デーモンに届く任意の URL。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, 리버스 프록시 등 데몬에 닿는 모든 URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, proxy reverso: qualquer URL que chegue ao daemon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel, WireGuard, обратный прокси — любой URL до демона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare Tunnel、WireGuard、反向代理——任何能访问守护进程的 URL。"
          }
        }
      }
    },
