        }
      }
    },
    "server.add.intro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code bleibt auf deinem Server. Wähle, wie dieser Mac ihn erreicht. Jede Option ergibt dieselbe verschlüsselte Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code stays on your server. Choose how this Mac reaches it. Every option gives the same encrypted connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código se queda en tu servidor. Elige cómo llega este Mac a él: todas las opciones dan la misma conexión cifrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code reste sur votre serveur. Choisissez comment ce Mac y accède : chaque option donne la même connexion chiffrée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはあなたのサーバーに残ります。この Mac からどう接続するか選んでください。どの方法でも、同じ暗号化された接続になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 사용자의 서버에 남습니다. 이 Mac이 서버에 연결하는 방식을 고르세요. 어떤 방식이든 같은 암호화 연결입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código fica no seu servidor. Escolha como este Mac vai acessá-lo: todas as opções dão a mesma conexão criptografada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код остаётся на вашем сервере. Выберите, как этот Mac до него дотянется, — любой способ даёт одно и то же зашифрованное соединение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码始终留在你的服务器上。请选择这台 Mac 如何连接它，每种方式都提供相同的加密连接。"
          }
        }
      }
    },
