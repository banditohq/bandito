    "onboarding.welcome.subsText": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT (Codex) oder Grok: Bandito startet deren offizielle Programme. Keine neuen Konten nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT (Codex) or Grok — Bandito runs their official programs. No new accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT (Codex) o Grok: Bandito ejecuta sus programas oficiales. Sin cuentas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT (Codex) ou Grok : Bandito lance leurs programmes officiels. Aucun nouveau compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、ChatGPT（Codex）、Grok のいずれかを、Bandito が公式プログラムとして起動します。新しいアカウントは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT(Codex), Grok 중 하나를 Bandito가 공식 프로그램으로 실행합니다. 새 계정은 필요 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT (Codex) ou Grok: o Bandito roda os programas oficiais deles. Sem contas novas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, ChatGPT (Codex) или Grok — Bandito запускает их официальные программы. Никаких новых счетов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、ChatGPT（Codex）或 Grok——Bandito 运行它们的官方程序。无需新建账户。"
          }
        }
      }
    },
    "onboarding.welcome.subsTitle": {
      "localizations": {
