    "template.researcher.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht, liest und vergleicht und liefert eine Zusammenfassung mit Links."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches, reads and compares, brings back a digest with links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca, lee y compara, y trae un resumen con enlaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche, lit et compare, et rapporte une synthèse avec des liens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索、読解、比較を行い、リンク付きの要約を返します。"
