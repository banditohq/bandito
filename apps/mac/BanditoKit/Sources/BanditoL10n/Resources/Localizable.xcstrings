    "template.assistant.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mails, Kalender, Notizen, Erinnerungen — in normaler Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail, calendar, notes, reminders — in plain language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correo, calendario, notas y recordatorios, en lenguaje normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails, agenda, notes, rappels — en langage courant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール、カレンダー、メモ、リマインダー。普通の言葉で頼めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일, 캘린더, 메모, 알림 — 일상 언어로 요청하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mail, agenda, notas e lembretes, em linguagem comum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почта, календарь, заметки, напоминания — на обычном языке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件、日历、笔记、提醒——用日常语言即可。"
          }
        }
      }
    },
