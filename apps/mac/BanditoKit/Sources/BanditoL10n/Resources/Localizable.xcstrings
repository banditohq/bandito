{
  "sourceLanguage": "en",
  "strings": {
    "agent.delete.confirm": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ löschen? Der Verlauf bleibt auf dem Server erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %1$@? Its history stays on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %1$@? Su historial se conserva en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %1$@ ? Son historique reste sur le serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を削除しますか？履歴はサーバーに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 삭제할까요? 기록은 서버에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %1$@? O histórico continua no servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@? Его история останется на сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %1$@？其历史记录将保留在服务器上。"
          }
        }
      }
    },
