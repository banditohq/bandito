    "chapter.resumed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapitel %1$lld · %2$@ hat sein Gedächtnis neu gelesen und dort weitergemacht, wo es aufgehört hat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapter %1$lld · %2$@ reread its memory and picked up where it left off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capítulo %1$lld · %2$@ releyó su memoria y retomó donde lo dejó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chapitre %1$lld · %2$@ a relu sa mémoire et repris là où il s'était arrêté"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャプター %1$lld · %2$@ は記憶を読み直し、前回の続きから再開"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "챕터 %1$lld · %2$@이(가) 기억을 다시 읽고 이어서 진행"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capítulo %1$lld · %2$@ releu a memória e continuou de onde parou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глава %1$lld · %2$@ перечитал память и продолжает с того же места"
          }
        },
