    "memory.dailyDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Morgen eine leere Seite. Gut für Assistenten mit täglichen Aufgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clean page every morning. Good for assistants with daily tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página limpia cada mañana. Ideal para asistentes con tareas diarias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page blanche chaque matin. Idéal pour les assistants avec des tâches quotidiennes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝まっさらな状態から始めます。毎日のタスクを持つアシスタント向けです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 아침 빈 페이지에서 시작합니다. 매일 하는 작업이 있는 어시스턴트에 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma página limpa toda manhã. Bom para assistentes com tarefas diárias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое утро — чистый лист. Для ассистентов с ежедневными задачами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上都是空白页。适合有日常任务的助手。"
          }
        }
      }
    },
