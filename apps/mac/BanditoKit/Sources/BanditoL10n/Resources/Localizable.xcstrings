    "onboarding.server.ownServerDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft rund um die Uhr. Ein VPS, ein Heim-PC oder ein Arbeitsserver: Wir verbinden uns per SSH und installieren alles selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs around the clock. A VPS, a home PC or a work server — we connect over SSH and install everything ourselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona las 24 horas. Un VPS, un PC de casa o un servidor de trabajo: nos conectamos por SSH e instalamos todo nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourne en permanence. Un VPS, un PC personnel ou un serveur de travail : nous nous connectons en SSH et installons tout nous-mêmes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24 時間動きます。VPS、家庭用 PC、業務用サーバーなど。SSH で接続し、すべて自動でセットアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "24시간 돌아갑니다. VPS, 집 PC, 업무용 서버 모두 가능합니다. SSH로 연결해 모든 것을 직접 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona o tempo todo. Um VPS, um PC de casa ou um servidor de trabalho: conectamos por SSH e instalamos tudo sozinhos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает круглосуточно. VPS, домашний ПК или рабочий сервер — подключимся по SSH и всё установим сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天候运行。VPS、家用电脑或工作服务器都可以——我们通过 SSH 连接，并自行完成全部安装。"
          }
        }
      }
    },
