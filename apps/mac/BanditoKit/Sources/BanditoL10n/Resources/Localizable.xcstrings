    "banner.limit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzungslimit erreicht. Wird um %1$@ zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage limit reached. Resets at %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de uso alcanzado. Se restablece a las %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite d'utilisation atteinte. Réinitialisation à %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用上限に達しました。%1$@ にリセットされます。"
