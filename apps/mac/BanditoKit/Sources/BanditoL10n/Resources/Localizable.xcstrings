    "memory.smartDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Kapitel, wenn das Gespräch wächst, und jeden Morgen ein Neuanfang. Passt für fast alle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New chapter when the conversation grows, and a fresh start each morning. Fits almost everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo capítulo cuando la conversación crece, y un inicio nuevo cada mañana. Sirve a casi todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveau chapitre quand la conversation s'allonge, et un nouveau départ chaque matin. Convient à presque tout le monde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話が長くなったときと、毎朝の新しい一日で新しいチャプターを開始。ほとんどの人に合います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화가 길어지면 새 챕터를 시작하고, 매일 아침 새로 시작합니다. 거의 모든 사람에게 맞습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo capítulo quando a conversa cresce, e um recomeço a cada manhã. Serve para quase todo mundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новая глава, когда разговор разрастается, и с утра нового дня. Подходит почти всем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话变长时开启新章节，每天早上重新开始。几乎适合所有人。"
          }
        }
      }
    },
