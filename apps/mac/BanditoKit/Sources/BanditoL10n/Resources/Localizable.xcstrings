    "template.oncall.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überwacht Produktion und Logs und weckt dich nur, wenn es wichtig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watches production and logs, wakes you only when it matters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigila producción y logs, y solo te avisa cuando importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveille la production et les logs, et ne vous réveille que si c'est important."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本番環境とログを監視し、必要なときだけ知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운영 환경과 로그를 지켜보고, 중요할 때만 깨웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigia a produção e os logs, e só te acorda quando importa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следит за продом и логами, будит только по делу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监控生产环境和日志，只在重要时才叫醒你。"
          }
        }
      }
    },
