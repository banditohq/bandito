    "onboarding.welcome.sleepText": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten laufen auf deinem Server. Schließt du den Mac, arbeiten sie weiter und schicken dir morgens das Ergebnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents live on your server. Close your Mac and they keep going, then send you the result in the morning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes viven en tu servidor. Cierra el Mac y siguen con la tarea; por la mañana te envían el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents tournent sur votre serveur. Fermez votre Mac : ils poursuivent la tâche et vous envoient le résultat le matin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはあなたのサーバーで動きます。Mac を閉じても作業を続け、結果を朝に届けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 사용자의 서버에서 삽니다. Mac을 닫아도 계속 작업하고, 아침에 결과를 보내 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes vivem no seu servidor. Feche o Mac e eles continuam a tarefa, depois mandam o resultado de manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты живут на вашем сервере. Закройте Mac — они продолжат задачу и пришлют итог утром."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理运行在你的服务器上。合上 Mac 后它们会继续任务，并在早上把结果发给你。"
          }
        }
      }
    },
    "onboarding.welcome.sleepTitle": {
      "localizations": {
