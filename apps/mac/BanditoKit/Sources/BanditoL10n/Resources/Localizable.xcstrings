      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gelten immer, sofern keine Regel oben etwas anderes sagt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "always apply unless a rule above says otherwise"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "se aplican siempre salvo que una regla de arriba diga lo contrario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "s'appliquent toujours, sauf si une règle ci-dessus dit le contraire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のルールで別の指定がない限り常に適用"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 규칙에서 달리 정하지 않는 한 항상 적용"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sempre se aplicam, a não ser que uma regra acima diga o contrário"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "работают всегда, если правило выше не говорит иначе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非上方规则另有说明，始终生效"
          }
        }
      }
    },
