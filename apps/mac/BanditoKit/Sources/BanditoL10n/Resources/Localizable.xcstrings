    "onboarding.agent.firstMessage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Nachricht dauert nur Sekunden: %1$@ stellt sich vor und fragt, wo es losgehen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first message takes a few seconds: %1$@ introduces itself and asks where to start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer mensaje tarda unos segundos: %1$@ se presenta y pregunta por dónde empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier message ne prend que quelques secondes : %1$@ se présente et demande par où commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のメッセージは数秒で済みます。%1$@ が自己紹介し、どこから始めるか尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 메시지는 몇 초면 됩니다. %1$@이(가) 자기소개를 하고 어디서 시작할지 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira mensagem leva alguns segundos: %1$@ se apresenta e pergunta por onde começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое сообщение займёт пару секунд — %1$@ представится и спросит, с чего начать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一条消息只需几秒：%1$@ 会自我介绍，并询问从哪里开始。"
          }
        }
      }
    },
    "onboarding.agent.hire": {
