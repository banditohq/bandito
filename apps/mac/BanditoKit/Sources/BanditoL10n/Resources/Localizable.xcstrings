    "onboarding.account.heroText": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal anmelden, und alle deine Server und Agenten erscheinen auf jedem Gerät. Aufgaben vom Handy freigeben, auch wenn der Mac zu ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in once and all your servers and agents show up on every device. Approve tasks from your phone, even when the Mac is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión una vez y todos tus servidores y agentes aparecen en cualquier dispositivo. Aprueba tareas desde el teléfono, incluso con el Mac cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous une fois, et tous vos serveurs et agents apparaissent sur chaque appareil. Approuvez les tâches depuis votre téléphone, même Mac fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度サインインすれば、すべてのサーバーとエージェントがどのデバイスにも表示されます。Mac を閉じていても、スマホからタスクを承認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 로그인하면 모든 서버와 에이전트가 모든 기기에 나타납니다. Mac을 닫아도 휴대폰에서 작업을 승인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre uma vez e todos os seus servidores e agentes aparecem em qualquer dispositivo. Aprove tarefas pelo celular, mesmo com o Mac fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите один раз, и все ваши серверы и агенты появятся на любом устройстве. Одобряйте задачи с телефона, даже когда Mac закрыт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录一次，你的所有服务器和代理就会出现在每台设备上。即使 Mac 合上，也能用手机批准任务。"
          }
        }
      }
    },
