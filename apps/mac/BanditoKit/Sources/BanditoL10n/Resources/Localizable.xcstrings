    "agentSheet.runtimeLogin": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist auf %2$@ nicht angemeldet. Führe dort `%3$@` aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not logged in on %2$@. Run `%3$@` there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no ha iniciado sesión en %2$@. Ejecuta `%3$@` allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n'est pas connecté sur %2$@. Exécutez `%3$@` là-bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ で %1$@ にログインしていません。そこで `%3$@` を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에서 %1$@에 로그인되어 있지 않습니다. 그곳에서 `%3$@`을(를) 실행하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não está conectado em %2$@. Execute `%3$@` lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не выполнил вход на %2$@. Выполните там `%3$@`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@ 未登录。请在该服务器上运行 `%3$@`。"
          }
        }
      }
    },
