    "server.add.privacy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir öffnen keine Ports. Der Daemon lauscht nur auf dem Server selbst, und die App verbindet sich über einen SSH-Tunnel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We open no ports. The daemon listens only on the server itself, and the app connects through an SSH tunnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No abrimos puertos. El demonio escucha solo en el propio servidor y la app se conecta por un túnel SSH."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'ouvrons aucun port. Le démon n'écoute que sur le serveur lui-même, et l'app se connecte via un tunnel SSH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートは開きません。デーモンはサーバー自身でのみ待ち受け、アプリは SSH トンネル経由で接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트를 열지 않습니다. 데몬은 서버 자체에서만 수신하며, 앱은 SSH 터널로 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não abrimos portas. O daemon escuta apenas no próprio servidor, e o app se conecta por um túnel SSH."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порты не открываем. Демон слушает только сам сервер, приложение ходит через SSH-туннель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不开放任何端口。守护进程只在服务器本机监听，应用通过 SSH 隧道连接。"
          }
        }
      }
    },
