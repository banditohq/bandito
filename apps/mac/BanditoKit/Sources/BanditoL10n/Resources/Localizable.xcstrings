    "onboarding.account.privacy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir speichern nur deine Serverliste, verschlüsselt, und nur deine Geräte haben den Schlüssel. Code, API-Schlüssel und Gespräche bleiben auf deinen Servern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We only store your list of servers — encrypted, and only your devices hold the key. Code, API keys and conversations stay on your servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo guardamos tu lista de servidores, cifrada, y solo tus dispositivos tienen la clave. El código, las claves de API y las conversaciones se quedan en tus servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne stockons que votre liste de serveurs, chiffrée, et seuls vos appareils détiennent la clé. Code, clés API et conversations restent sur vos serveurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存するのはサーバーの一覧だけで、暗号化されています。鍵を持つのはあなたのデバイスだけです。コード、API キー、会話はあなたのサーバーに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저희는 서버 목록만 암호화해 보관하며, 키는 사용자의 기기에만 있습니다. 코드, API 키, 대화는 서버에 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardamos apenas a sua lista de servidores, criptografada, e só os seus dispositivos têm a chave. Código, chaves de API e conversas ficam nos seus servidores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы храним только список ваших серверов — зашифрованным, ключ есть лишь у ваших устройств. Код, ключи API и переписка остаются на ваших серверах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们只保存你的服务器列表，并且是加密的，只有你的设备持有密钥。代码、API 密钥和对话都留在你的服务器上。"
          }
        }
      }
    },
