    "server.add.sshDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt deine ~/.ssh/config. Bandito installiert sich selbst und verbindet sich über dieselbe Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your ~/.ssh/config. Bandito installs itself and connects over the same link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu ~/.ssh/config. Bandito se instala solo y se conecta por el mismo enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise votre ~/.ssh/config. Bandito s'installe lui-même et se connecte par la même liaison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.ssh/config を使います。Bandito は自分でインストールし、同じ接続で通信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.ssh/config를 사용합니다. Bandito가 스스로 설치되고 같은 연결로 통신합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa seu ~/.ssh/config. O Bandito se instala sozinho e conecta pelo mesmo caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Берём ваш ~/.ssh/config. Bandito сам установится и свяжется по тому же соединению."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的 ~/.ssh/config。Bandito 会自行安装，并通过同一连接通信。"
          }
        }
      }
    },
