    "onboarding.agent.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine fertige Rolle, dann stellen wir Modell, Anweisungen und Zeitplan ein. Alles lässt sich später ändern, und neue Agenten kannst du jederzeit hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a ready-made role and we'll set the model, instructions and schedule. You can change everything later, and add new agents any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un rol ya hecho y nosotros ponemos el modelo, las instrucciones y el horario. Todo se puede cambiar después y puedes añadir agentes en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un rôle prêt à l'emploi : nous réglons le modèle, les instructions et le planning. Tout est modifiable plus tard, et vous pouvez ajouter des agents à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用意された役割から選ぶと、モデル、指示、スケジュールを自動で設定します。すべてあとから変更でき、新しいエージェントはいつでも追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 역할을 고르면 모델, 지침, 일정을 자동으로 설정합니다. 나중에 모두 바꿀 수 있고, 새 에이전트는 언제든 추가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um papel pronto e a gente define o modelo, as instruções e a agenda. Tudo pode ser mudado depois, e você adiciona novos agentes quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите готовую роль — мы подставим модель, инструкции и расписание. Всё можно поменять потом, а новых агентов добавить в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个现成的角色，我们会帮你设置模型、指令和计划。之后都可以修改，也能随时添加新代理。"
          }
        }
      }
    },
