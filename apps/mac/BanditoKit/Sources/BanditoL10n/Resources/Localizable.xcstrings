    "onboarding.server.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten laufen auf einem Rechner, der durchgehend an ist. Nimm deinen eigenen Server, einen Heim-PC oder einfach diesen Mac zum Ausprobieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents run on a computer that stays on. Use your own server, a home PC, or this Mac just to try things out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes funcionan en un equipo que siempre está encendido. Usa tu propio servidor, un PC de casa o este Mac solo para probar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents tournent sur un ordinateur allumé en permanence. Utilisez votre propre serveur, un PC à la maison ou simplement ce Mac pour essayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは常時起動しているコンピュータで動きます。自分のサーバー、家庭用 PC、または試すだけならこの Mac を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 계속 켜져 있는 컴퓨터에서 돌아갑니다. 자신의 서버, 집 PC, 또는 그냥 한번 써 보려면 이 Mac을 쓸 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes rodam em um computador que fica ligado. Use seu próprio servidor, um PC de casa ou este Mac só para testar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты работают на компьютере, который не выключается. Подойдёт свой сервер, домашний ПК или — чтобы просто попробовать — этот Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理运行在一台不关机的电脑上。可以用你自己的服务器、家用电脑，或者只是试试的话用这台 Mac。"
          }
        }
      }
    },
    "onboarding.server.thisMacDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell ausprobiert. Agenten laufen nur, solange der Mac wach und offen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick to try. Agents run only while the Mac is awake and open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido de probar. Los agentes funcionan solo mientras el Mac esté despierto y abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide à essayer. Les agents ne tournent que si le Mac est éveillé et ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐ試せます。エージェントは Mac が起きていて開いている間だけ動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 써 볼 수 있습니다. 에이전트는 Mac이 깨어 있고 열려 있는 동안만 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rápido para testar. Os agentes rodam só enquanto o Mac estiver acordado e aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро попробовать. Агенты работают, пока Mac не спит и не закрыт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上手快，可以马上试。代理只在 Mac 醒着且未合盖时运行。"
          }
        }
      }
    },
