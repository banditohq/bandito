    "tour.approve.text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, Deployments und Löschungen landen hier. Erlaube sie mit einem Klick oder lehne sie ab. Du kannst auch am Handy antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, deploys and deletes come to you. Allow with a button, or deny. You can also answer from your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los push, despliegues y borrados llegan aquí. Permite con un botón o deniega. También puedes responder desde el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les push, déploiements et suppressions arrivent ici. Autorisez d'un clic ou refusez. Vous pouvez aussi répondre depuis votre téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "push、デプロイ、削除の要求はここに届きます。ボタンで許可するか拒否できます。スマホからも答えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "push, 배포, 삭제 요청이 여기로 옵니다. 버튼으로 허용하거나 거부하세요. 휴대폰으로도 답할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, deploys e exclusões chegam aqui. Permita com um botão ou negue. Você também pode responder pelo celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуш, деплой, удаление агент принесёт сюда. Разрешить — кнопкой, отклонить — тоже. Ответить можно и с телефона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送、部署和删除会送到这里。点按钮允许或拒绝。也可以用手机回复。"
          }
        }
      }
    },
    "tour.approve.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Riskantes braucht dein Ja"
