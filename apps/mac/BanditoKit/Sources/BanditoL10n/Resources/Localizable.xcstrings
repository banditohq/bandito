    "chapter.explainer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Kapitel voll ist, speichert %1$@ das Wichtige im Gedächtnis und beginnt mit einer leeren Seite. Der Verlauf bleibt vollständig im Fenster, und jede neue Nachricht wird nicht teurer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a chapter fills up, %1$@ saves what matters to memory and starts with a clean page. The conversation stays whole in the window, and each new message doesn't cost more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un capítulo se llena, %1$@ guarda lo importante en la memoria y empieza en una página limpia. La conversación se mantiene completa en la ventana y cada mensaje nuevo no encarece nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un chapitre se remplit, %1$@ enregistre l'essentiel en mémoire et repart sur une page blanche. La conversation reste entière dans la fenêtre, et chaque nouveau message ne coûte pas plus cher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャプターがいっぱいになると、%1$@ が大事なことを記憶に保存して白紙から始めます。会話はウィンドウに丸ごと残り、新しいメッセージが高くなることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "챕터가 가득 차면 %1$@이(가) 중요한 내용을 기억에 저장하고 빈 페이지에서 시작합니다. 대화는 창에 그대로 남고, 새 메시지도 비용이 늘지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um capítulo enche, %1$@ salva o que importa na memória e começa numa página limpa. A conversa fica inteira na janela, e cada nova mensagem não fica mais cara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда глава заполнится, %1$@ сам запишет важное в память и начнёт с чистого листа. Переписка в окне остаётся целиком, а каждое новое сообщение не дорожает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "章节写满后，%1$@ 会把重要内容存入记忆，然后从空白开始。对话会完整保留在窗口中，而且每条新消息都不会更贵。"
          }
        }
      }
    },
    "chapter.nextAt": {
      "localizations": {
