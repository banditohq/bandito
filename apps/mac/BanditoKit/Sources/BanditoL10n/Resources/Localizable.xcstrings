    "settings.approvalsIntro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito prüft jede Aktion des Agenten. Routinearbeit läuft von selbst, alles, was unter eine Regel unten oder eine eingebaute Prüfung fällt, wartet auf deine Entscheidung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito checks every action an agent takes. Routine work runs on its own, while anything that matches a rule below or a built-in check waits for your decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito revisa cada acción del agente. El trabajo rutinario avanza solo, mientras que lo que coincida con una regla de abajo o con una comprobación integrada espera tu decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito vérifie chaque action de l'agent. Le travail courant avance tout seul, tandis que tout ce qui correspond à une règle ci-dessous ou à un contrôle intégré attend votre décision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito はエージェントのすべての操作を確認します。通常の作業は自動で進み、下のルールや組み込みチェックに当たるものはあなたの判断を待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito는 에이전트의 모든 작업을 확인합니다. 일상적인 작업은 자동으로 진행되고, 아래 규칙이나 내장 검사에 해당하는 작업은 사용자의 결정을 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bandito verifica cada ação do agente. O trabalho rotineiro segue sozinho, enquanto o que bater com uma regra abaixo ou com uma verificação embutida espera sua decisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito проверяет каждое действие агента. Обычная работа идёт сама, а всё, что подходит под правило ниже или встроенную проверку, ждёт вашего решения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandito 会检查代理的每一项操作。日常工作自动进行，而符合下方规则或内置检查的操作会等待你的决定。"
          }
        }
      }
    },
