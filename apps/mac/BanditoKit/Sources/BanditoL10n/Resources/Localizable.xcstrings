    "template.reviewer.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Änderungen anderer Agenten und deine PRs und sucht nach Fehlern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviews other agents' changes and your PRs, looks for bugs."
          }
