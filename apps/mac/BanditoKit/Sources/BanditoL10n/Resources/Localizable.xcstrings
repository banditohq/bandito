    "agentSheet.approvalsHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, Deployments, Löschungen und Schreibzugriffe außerhalb von %1$@ warten auf dein Okay. Den Rest erledigt er selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, deploys, deletes and writes outside %1$@ wait for your go-ahead. It handles the rest on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los push, despliegues, borrados y escrituras fuera de %1$@ esperan tu visto bueno. El resto lo hace por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les push, déploiements, suppressions et écritures hors de %1$@ attendent votre accord. Le reste, il le gère seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の外への push、デプロイ、削除、書き込みは、あなたの許可を待ちます。それ以外は自分で処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 밖의 push, 배포, 삭제, 쓰기는 승인을 기다립니다. 나머지는 스스로 처리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, deploys, exclusões e gravações fora de %1$@ esperam sua aprovação. O resto ele faz sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуш, деплой, удаление и запись вне %1$@ ждут вашего «да». Остальное он делает сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送、部署、删除以及 %1$@ 之外的写入都会等待你的确认。其余操作它会自行完成。"
          }
        }
      }
    },
