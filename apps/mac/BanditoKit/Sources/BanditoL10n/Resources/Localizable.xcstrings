    "agentSheet.memoryHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt Notizen in einem eigenen Ordner, daher merkt er sich alles, und Nachrichten werden nicht teurer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps notes in its own folder, so it remembers everything and messages don't get more expensive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva notas en su propia carpeta, así recuerda todo y los mensajes no encarecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tient ses notes dans son propre dossier : il se souvient de tout, et les messages ne coûtent pas plus cher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のフォルダにメモを残すので、すべて覚えていて、メッセージが高くなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 폴더에 메모를 남겨 모든 것을 기억하며, 메시지 비용도 늘지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém notas na própria pasta, então lembra de tudo e as mensagens não ficam mais caras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ведёт заметки в своей папке, поэтому помнит всё, а сообщения не дорожают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在自己的文件夹里做笔记，因此能记住一切，而且消息不会变贵。"
          }
        }
      }
    },
