    "server.add.relayDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgehend, Ende-zu-Ende-verschlüsselt. Funktioniert hinter jedem NAT."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outbound only, end-to-end encrypted. Works behind any NAT."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo salida, cifrado de extremo a extremo. Funciona detrás de cualquier NAT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortant uniquement, chiffré de bout en bout. Fonctionne derrière n'importe quel NAT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信のみ、エンドツーエンド暗号化。どの NAT の内側でも動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아웃바운드 전용, 종단 간 암호화. 어떤 NAT 뒤에서도 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente saída, criptografia ponta a ponta. Funciona atrás de qualquer NAT."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только исходящее, сквозное шифрование. Работает за любым NAT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅出站、端到端加密。可在任何 NAT 后工作。"
          }
        }
      }
    },
