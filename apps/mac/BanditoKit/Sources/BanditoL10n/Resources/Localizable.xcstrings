    "template.builder.desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt und repariert Code, führt Tests aus und öffnet PRs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes and fixes code, runs tests, opens PRs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe y arregla código, ejecuta pruebas y abre PR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit et corrige le code, lance les tests, ouvre des PR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを書いて直し、テストを回し、PR を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 작성하고 고치며, 테스트를 돌리고, PR을 엽니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreve e corrige código, roda testes e abre PRs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишет и чинит код, гоняет тесты, открывает PR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编写和修复代码，运行测试，提交 PR。"
          }
        }
      }
    },
    "template.builder.instructions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du schreibst und reparierst Code im Projekt. Du machst kleine Änderungen, führst vor jedem Commit die Tests aus, öffnest einen PR und fasst kurz zusammen, was du getan hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You write and fix code in the project. You make small changes, run the tests before every commit, open a PR, and briefly write what you did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribes y arreglas código en el proyecto. Haces cambios pequeños, ejecutas las pruebas antes de cada commit, abres un PR y escribes brevemente lo que hiciste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous écrivez et corrigez le code du projet. Vous faites de petites modifications, lancez les tests avant chaque commit, ouvrez une PR et résumez brièvement ce que vous avez fait."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのコードを書いて直します。小さな変更を加え、コミットの前に毎回テストを回し、PR を開いて、何をしたかを短く書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트의 코드를 작성하고 고칩니다. 작은 변경을 하고, 커밋 전에 매번 테스트를 돌리고, PR을 열고, 한 일을 짧게 적습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você escreve e corrige código no projeto. Faz mudanças pequenas, roda os testes antes de cada commit, abre um PR e escreve brevemente o que fez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишешь и чинишь код в проекте. Делаешь маленькие изменения, гоняешь тесты перед каждым коммитом, открываешь PR и кратко пишешь, что сделал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在项目中编写和修复代码。做小幅改动，每次提交前运行测试，开 PR，并简要说明做了什么。"
          }
        }
      }
    },
