    "onboarding.welcome.askText": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, Deployments und Löschungen nur mit deinem Ja. Antworte am Mac, über eine Benachrichtigung oder am iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, deploys, deletes — only with your yes. Answer from the Mac, from a notification, or from an iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, despliegues y borrados solo con tu sí. Responde desde el Mac, desde una notificación o desde un iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, déploiements, suppressions : seulement avec votre accord. Répondez depuis le Mac, une notification ou un iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "push、デプロイ、削除はあなたが「はい」と答えた場合のみ。Mac、通知、iPhone のどこからでも答えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "push, 배포, 삭제는 사용자가 승인해야만 합니다. Mac, 알림, iPhone 어디서든 답할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushes, deploys e exclusões só com seu sim. Responda pelo Mac, por uma notificação ou pelo iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пуш, деплой, удаление — только с вашего «да». Ответить можно с Mac, из уведомления или с iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推送、部署、删除都必须得到你的同意。可以在 Mac、通知或 iPhone 上回复。"
          }
        }
      }
    },
    "onboarding.welcome.askTitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie fragen, bevor es riskant wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They ask before anything risky"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntan antes de lo arriesgado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils demandent avant toute action risquée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "危険な操作の前に確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험한 작업 전에는 먼저 묻습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntam antes do que é arriscado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивают перед рискованным"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有风险的操作前会先询问"
          }
        }
      }
    },
    "onboarding.welcome.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source · dein Code und deine Schlüssel verlassen nie deine Server"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source · your code and keys never leave your servers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código abierto · tu código y tus claves nunca salen de tus servidores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source · votre code et vos clés ne quittent jamais vos serveurs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンソース · コードとキーはあなたのサーバーから出ません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오픈 소스 · 코드와 키는 서버 밖으로 나가지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Código aberto · seu código e suas chaves nunca saem dos seus servidores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый код · ваш код и ключи не покидают ваши серверы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源 · 你的代码和密钥永远不会离开你的服务器"
          }
        }
      }
    },
    "onboarding.welcome.haveAccount": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon ein Konto?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already have an account?"
          }
        },
        "es": {
