    "onboarding.account.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos, damit deine Geräte einander finden. Ein Passwort musst du dir nicht ausdenken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's free, and it lets your devices find each other. You won't need to make up a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gratis y sirve para que tus dispositivos se encuentren. No tendrás que inventar una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit, il permet à vos appareils de se retrouver. Inutile d'inventer un mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料で、デバイス同士が互いを見つけるために使います。パスワードを考える必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료이며, 기기들이 서로를 찾도록 해 줍니다. 비밀번호를 만들 필요는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É gratuita e permite que seus dispositivos se encontrem. Você não precisa criar uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он бесплатный и нужен, чтобы устройства узнавали друг друга. Пароль придумывать не придётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费，用于让你的设备互相找到。无需设置密码。"
          }
        }
      }
    },
