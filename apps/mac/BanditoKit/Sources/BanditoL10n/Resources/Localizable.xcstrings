    "tour.team.text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent hat seinen eigenen Chat. Der orangefarbene Punkt zeigt, dass jemand auf deine Entscheidung wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each agent is its own chat. The orange dot means someone is waiting for your decision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente tiene su propio chat. El punto naranja indica que alguien espera tu decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque agent a son propre chat. Le point orange indique que quelqu'un attend votre décision."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントごとに個別のチャットがあります。オレンジの点は、誰かがあなたの判断を待っていることを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트마다 별도의 채팅이 있습니다. 주황색 점은 누군가 사용자의 결정을 기다린다는 뜻입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente tem o seu próprio chat. O ponto laranja indica que alguém espera sua decisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый агент — отдельный чат. Оранжевая точка значит, что кто-то ждёт вашего решения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个代理都是独立的聊天。橙色圆点表示有人在等你做决定。"
          }
        }
      }
    },
    "tour.team.title": {
