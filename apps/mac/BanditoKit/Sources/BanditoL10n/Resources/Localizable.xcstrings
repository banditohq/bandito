    "onboarding.server.noPorts": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir öffnen keine Ports: Der Server lauscht nur auf sich selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We open no ports: the server only listens to itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No abrimos ningún puerto: el servidor solo escucha en sí mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'ouvrons aucun port : le serveur n'écoute que lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートは一切開きません。サーバーは自分自身だけで待ち受けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부로 포트를 열지 않습니다. 서버는 자기 자신만 수신합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não abrimos portas: o servidor só escuta a si mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наружу ничего не открываем: сервер слушает только сам себя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们不开放任何端口：服务器只监听它自己。"
          }
        }
      }
    },
