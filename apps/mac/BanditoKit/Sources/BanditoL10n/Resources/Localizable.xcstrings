    "memory.footer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfache Markdown-Dateien auf deinem Server. Du kannst sie öffnen, bearbeiten oder löschen. Der Agent liest die neue Version im nächsten Kapitel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain Markdown files on your server. You can open, edit or delete them. The agent reads the new version in the next chapter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos Markdown normales en tu servidor. Puedes abrirlos, editarlos o borrarlos. El agente lee la nueva versión en el siguiente capítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers Markdown simples sur votre serveur. Vous pouvez les ouvrir, les modifier ou les supprimer. L'agent lit la nouvelle version au chapitre suivant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上のプレーンな Markdown ファイルです。開く、編集する、削除することができます。エージェントは次のチャプターで新しいバージョンを読みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 있는 일반 Markdown 파일입니다. 열기, 편집, 삭제할 수 있습니다. 에이전트는 다음 챕터에서 새 버전을 읽습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos Markdown simples no seu servidor. Você pode abrir, editar ou excluir. O agente lê a nova versão no próximo capítulo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычные Markdown-файлы на вашем сервере. Их можно открыть, поправить или удалить — агент прочитает новую версию в следующей главе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上的普通 Markdown 文件。你可以打开、编辑或删除。代理会在下一章节读取新版本。"
          }
        }
      }
    },
    "memory.full": {
