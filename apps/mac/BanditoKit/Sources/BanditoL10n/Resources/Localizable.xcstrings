    "effort.hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höherer Aufwand ist bei schwierigen Aufgaben klüger, aber langsamer und verbraucht das Limit schneller. Für den Alltag reicht Mittel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher effort is smarter on hard tasks, but slower and uses up your limit faster. Medium is enough for everyday work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esfuerzo mayor es más listo en tareas difíciles, pero va más lento y gasta el límite más rápido. Para el trabajo diario basta con medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un effort plus élevé est plus intelligent sur les tâches difficiles, mais plus lent et consomme la limite plus vite. Pour le travail courant, « Moyen » suffit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業量を上げると難しい作業で賢くなりますが、遅くなり、上限も早く減ります。日常の作業なら「中」で十分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노력 수준을 높이면 어려운 작업에서 더 똑똑하지만 느리고 한도를 더 빨리 씁니다. 일상 작업에는 보통이면 충분합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esforço maior é mais inteligente em tarefas difíceis, mas é mais lento e consome o limite mais rápido. Para o dia a dia, o médio basta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем выше, тем умнее на сложных задачах, но дольше и быстрее тратит лимит. Для обычной работы хватает среднего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投入度越高，在难题上越聪明，但速度更慢，也会更快用完额度。日常工作用“中”就够了。"
          }
        }
      }
    },
