    "rules.wildcardNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "* passt auf alles. Wenn zwei Regeln passen, gewinnt die Regel für einen bestimmten Agenten, danach die neuere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "* matches anything. If two rules match, a rule for a specific agent wins, then the newer one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "* coincide con cualquier cosa. Si dos reglas coinciden, gana la de un agente concreto y, después, la más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* correspond à tout. Si deux règles correspondent, celle d'un agent précis l'emporte, puis la plus récente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "* は任意の文字列に一致します。2 つのルールに一致する場合は、特定のエージェント向けのルールが優先され、次に新しいルールが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "*는 무엇이든 일치합니다. 두 규칙이 일치하면 특정 에이전트용 규칙이 우선하고, 그다음 최신 규칙이 우선합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "* corresponde a qualquer coisa. Se duas regras baterem, vence a de um agente específico e, depois, a mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "* — что угодно. Если подходят два правила, побеждает правило конкретного агента, затем более новое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "* 匹配任意内容。若两条规则都匹配，则优先特定代理的规则，其次是较新的规则。"
          }
        }
      }
    },
