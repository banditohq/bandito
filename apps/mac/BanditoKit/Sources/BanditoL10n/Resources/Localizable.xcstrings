    "memory.fullDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent komprimiert alte Nachrichten selbst. Praktisch für eine große Aufgabe, aber teurer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent compresses old messages itself. Handy for one big task, but costs more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente comprime los mensajes antiguos por sí mismo. Útil para una tarea grande, pero cuesta más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent compresse lui-même les anciens messages. Pratique pour une grosse tâche, mais plus coûteux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いメッセージはエージェントが自分で圧縮します。大きな作業ひとつには便利ですが、高くつきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 오래된 메시지를 스스로 압축합니다. 큰 작업 하나에 편하지만 비용이 더 듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente comprime as mensagens antigas sozinho. Prático para uma tarefa grande, mas custa mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
