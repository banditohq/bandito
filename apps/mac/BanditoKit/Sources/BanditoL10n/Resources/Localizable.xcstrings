    "tour.limits.text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier siehst du, wie viel von deinem Limit bei Claude, ChatGPT und Grok noch übrig ist und wann es zurückgesetzt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see how much of your Claude, ChatGPT and Grok limit is left, and when it resets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí ves cuánto límite te queda en tus suscripciones de Claude, ChatGPT y Grok, y cuándo se restablece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, vous voyez combien de limite il reste sur vos abonnements Claude, ChatGPT et Grok, et quand elle se réinitialise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、ChatGPT、Grok のサブスクリプションの残り上限と、リセット時刻がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 Claude, ChatGPT, Grok 구독의 남은 한도와 초기화 시점을 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui você vê quanto limite ainda resta nas suas assinaturas de Claude, ChatGPT e Grok, e quando ele é redefinido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь видно, сколько лимита осталось у ваших подписок Claude, ChatGPT и Grok — и когда он сбросится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里可以看到你的 Claude、ChatGPT 和 Grok 订阅还剩多少额度，以及何时重置。"
          }
        }
      }
    },
    "tour.limits.title": {
