    "onboarding.server.noServerDesc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder VPS ab 5 $ im Monat reicht. Wir zeigen dir Schritt für Schritt, wo du einen bekommst und was du klicken musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any VPS from $5 a month will do. We'll walk you through where to get one and what to click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale cualquier VPS desde 5 $ al mes. Te explicamos paso a paso dónde conseguirlo y qué pulsar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout VPS à partir de 5 $ par mois fera l'affaire. Nous vous guidons pas à pas pour en obtenir un."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額 $5 からの VPS ならどれでも使えます。入手先と操作手順をご案内します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월 5달러부터 하는 VPS면 어떤 것이든 됩니다. 어디서 구하고 무엇을 누르면 되는지 단계별로 안내합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve qualquer VPS a partir de US$ 5 por mês. Mostramos passo a passo onde conseguir e o que clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подойдёт любой VPS от $5 в месяц. Покажем по шагам, где взять и что нажать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月费 5 美元起的任何 VPS 都可以。我们会一步步告诉你去哪里获取、点哪里。"
          }
        }
      }
    },
