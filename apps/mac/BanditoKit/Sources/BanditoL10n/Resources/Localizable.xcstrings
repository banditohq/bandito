    "onboarding.server.addressHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So meldest du dich normalerweise per SSH an: benutzer@adresse. Wir verwenden deine Schlüssel aus %1$@ und fragen nicht nach einem Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how you usually sign in over SSH: user@address. We use your keys from %1$@, and we won't ask for a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así sueles entrar por SSH: usuario@dirección. Usamos tus claves de %1$@ y no pediremos contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est ainsi que vous vous connectez habituellement en SSH : utilisateur@adresse. Nous utilisons vos clés de %1$@ et ne demandons pas de mot de passe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普段の SSH 接続は user@address の形式です。鍵は %1$@ のものを使い、パスワードは聞きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보통 SSH로 로그인하는 방식: 사용자@주소. %1$@의 키를 사용하며 비밀번호는 묻지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É assim que você costuma entrar por SSH: usuario@endereco. Usamos suas chaves de %1$@ e não pediremos senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как вы обычно заходите по SSH: пользователь@адрес. Мы используем ваши ключи из %1$@ — пароль не спросим."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你平时通过 SSH 登录的格式：用户@地址。我们会使用 %1$@ 中的密钥，不会索要密码。"
          }
        }
      }
    },
