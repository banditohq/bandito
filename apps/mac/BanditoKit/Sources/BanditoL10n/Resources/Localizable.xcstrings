    "onboarding.welcome.subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten auf Basis von Claude Code, Codex und Grok, mit Rollen und Zeitplänen. Sie arbeiten weiter, wenn du den Laptop zuklappst, und fragen vor allem Riskanten nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents on Claude Code, Codex and Grok, with roles and schedules. They keep working when you close your laptop, and ask before anything risky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes con Claude Code, Codex y Grok, con roles y horarios. Siguen trabajando aunque cierres el portátil y preguntan antes de cualquier acción arriesgada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des agents sur Claude Code, Codex et Grok, avec des rôles et des plannings. Ils continuent à travailler quand vous fermez votre portable et demandent avant toute action risquée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code、Codex、Grok で動くエージェント。役割とスケジュールを設定できます。ノートパソコンを閉じても動き続け、危険な操作の前には必ず確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex, Grok 기반 에이전트에 역할과 일정을 줄 수 있습니다. 노트북을 닫아도 계속 일하고, 위험한 작업 전에는 먼저 묻습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes com Claude Code, Codex e Grok, com funções e agendas. Continuam trabalhando quando você fecha o notebook e perguntam antes de qualquer ação arriscada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты на Claude Code, Codex и Grok с ролями и расписанием. Работают, когда вы закрыли ноутбук, и спрашивают перед всем рискованным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 Claude Code、Codex 和 Grok 的代理，可设置角色和计划。合上笔记本后仍会继续工作，遇到有风险的操作会先询问。"
          }
        }
      }
    },
