    "tour.write.text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib einfach: „Füge Tests für die Zahlung hinzu und öffne einen PR“. Der Agent findet selbst heraus, was er ausführen muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use plain words: “add tests for payments and open a PR”. The agent works out what to run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa palabras normales: «añade tests para los pagos y abre un PR». El agente averigua qué ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez simplement : « ajoute des tests pour les paiements et ouvre une PR ». L'agent trouve seul quoi lancer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通の言葉で書きます：「決済のテストを追加して PR を開いて」。何を実行するかはエージェントが判断します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평범한 말로 쓰세요: “결제 테스트를 추가하고 PR을 열어줘”. 무엇을 실행할지는 에이전트가 알아서 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use palavras simples: “adicione testes para pagamentos e abra um PR”. O agente descobre o que rodar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычными словами: «добавь тесты для оплаты и открой PR». Агент сам разберётся, что запустить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用普通的话说：“给支付加上测试，然后开个 PR”。代理会自己判断该运行什么。"
          }
        }
      }
    },
