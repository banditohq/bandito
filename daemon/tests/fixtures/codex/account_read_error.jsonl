// account_plan when the account read is refused (not logged in): the answer is an error, so there is no plan.
{"expect": {"method": "initialize"}}
{"send": {"id": "$last:/id", "result": {"userAgent": "bandito/0.161.0"}}}
{"expect": {"method": "initialized"}}
{"expect": {"method": "account/read", "id": 2}}
{"send": {"id": "$last:/id", "error": {"code": -32000, "message": "not logged in"}}}
