{"send": {"method": "item/completed", "params": {"threadId": "thr-e", "turnId": "turn-e", "completedAtMs": 1791530172000, "item": {"type": "agentMessage", "id": "m-e", "text": "Done."}}}}
{"send": {"method": "turn/completed", "params": {"threadId": "thr-e", "turn": {"id": "turn-e", "items": [], "status": "completed", "error": null}}}}
