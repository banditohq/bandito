// Resuming a stored thread; an unsupported server request gets a JSON-RPC error.
{"expect": {"method": "initialize"}}
{"send": {"id": "$last:/id", "result": {}}}
{"expect": {"method": "initialized"}}
{"expect": {"method": "thread/resume", "params": {"threadId": "thr-old", "approvalPolicy": "untrusted", "sandbox": "workspace-write"}}}
{"send": {"id": "$last:/id", "result": {"thread": {"id": "thr-old"}}}}
