{"expect": {"id": 11, "error": {"code": -32601}}}
{"send": {"method": "item/started", "params": {"threadId": "thr-old", "turnId": "turn-5", "item": {"type": "mcpToolCall", "id": "mcp-1", "server": "bandito", "tool": "crew_send", "arguments": {"to": "Scout", "message": "review please"}, "status": "inProgress"}}}}
{"send": {"method": "item/completed", "params": {"threadId": "thr-old", "turnId": "turn-5", "completedAtMs": 1, "item": {"type": "mcpToolCall", "id": "mcp-1", "server": "bandito", "tool": "crew_send", "arguments": {}, "status": "completed", "result": {"content": [{"type": "text", "text": "sent to Scout"}]}}}}}
{"send": {"method": "turn/completed", "params": {"threadId": "thr-old", "turn": {"id": "turn-5", "items": [], "status": "completed", "error": null}}}}
